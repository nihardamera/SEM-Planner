# Copy this file to backend/.env and fill in your own values.
# backend/.env is listed in .gitignore. Never commit it.

# Groq API key, used for the language model calls.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional: Groq model name. Defaults to llama-3.1-8b-instant.
# GROQ_MODEL=llama-3.1-8b-instant

# Google Ads customer ID used for Keyword Planner requests (10 digits, dashes allowed).
# Leave unset to run in estimated-data mode.
# GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# Optional: path to the Google Ads client configuration.
# Defaults to backend/google-ads.yaml (copy it from backend/google-ads.yaml.example).
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=/absolute/path/to/google-ads.yaml

# Optional: comma-separated list of origins allowed to call the API from a browser.
# Defaults to the local Vite dev and preview servers.
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
